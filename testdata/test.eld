zone hello;

#[
	这是一行多行注释
]#

'main : fn () {
    'str:box::new ..
	print
	  .str::format?
	  # 此处返回特殊视图'[T R | E]
	  .| "hello {x}" |
	  ::collect_err ..
	  # 该方法尝试匹配 E，并返回一个'E
	  ::except .| E =>  "Err! { E }"|
}

# 该调用写法等价于其他语言的print(format("...")?).collect_err().except(....)
# view视图，用'x声明，用于从某一特定角度观察值
#[
	万物皆视图，一个视图应该能自动推导对值有何约束这种信息，值是一个形状，
	每个视图基于他拥有的方法选取这个形状的一部分做裁切，约束的并集就是值的接口集，
	如果句柄 A 要求值有尖角，B 要求值是一个矩形，
	那么，当矩形变成三角形的时候，B 失效 A 维持
]#
